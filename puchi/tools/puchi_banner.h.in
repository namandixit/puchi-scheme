/* puchi.h - amalgamated portable Chibi Scheme kernel
 *
 * Generated by puchi/tools/amalgamate.sh. Do not edit this file.
 * Change the scripts (and puchi_host_embed.py) and re-run.
 *
 * Host contract: core is CPU/memory only. The host owns OS I/O, clocks,
 * and process death. Pass puchi_host at context create; install ports with
 * puchi_stream_ops (or string ports). Scheme calls C only via host-registered
 * foreigns (sexp_define_foreign).
 *
 * True single-header: no #include of opt/, chibi/, or lib/ project files.
 * OS/debug backends (dlopen, Boehm, green threads, mmap, image load, …) are
 * deleted from this amalgamation — not merely forced off. Do not re-enable.
 *
 * Module path starts empty; host/harness calls add-module-directory and may
 * boot meta-7. sexp_load_default_libs / sexp_load_standard_env load embedded
 * init-7 only (no disk). STATIC_LIBS / include-shared is harness-only
 * (define PUCHI_TEST in the test harness).
 *
 * ----------------------------------------------------------------------
 * How to use
 * ----------------------------------------------------------------------
 * In exactly one .c file:
 *
 *   #define PUCHI_IMPLEMENTATION
 *   #include "puchi.h"
 *
 *   static void *my_alloc(void *ud, size_t n) { (void)ud; return malloc(n); }
 *   static void my_free(void *ud, void *p) { (void)ud; free(p); }
 *   static void my_diag(void *ud, int code, const char *msg) { (void)ud; (void)code; (void)msg; }
 *   static void my_fatal(void *ud, int code, const char *msg); // must not return
 *
 *   puchi_host host = { NULL, my_alloc, my_free, my_diag, my_fatal };
 *   sexp ctx = sexp_create_context(0, 0, &host);  // NULL host => CRT defaults
 *   sexp_load_default_libs(ctx);
 *   sexp res = sexp_eval_string(ctx, "(+ 1 2)", -1, NULL);
 *   sexp_delete_context(ctx);
 *
 * Numeric modes: (none) / PUCHI_ENABLE_NUMERICAL_TOWER / PUCHI_INTEGER_ONLY
 * (do not set SEXP_USE_FLONUMS/BIGNUMS by hand).
 *
 * License: BSD-style (upstream COPYING / Alex Shinn).
 */
#ifndef PUCHI_H
#define PUCHI_H

#ifdef __cplusplus
extern "C" {
#endif

#include <stddef.h>
#include <stdlib.h>
#include <string.h>
#include <stdarg.h>
#include <ctype.h>
/* MSVC: must precede math.h so M_LN10 / M_PI exist (features.h is too late). */
#if defined(_WIN32) && defined(_MSC_VER)
#ifndef _USE_MATH_DEFINES
#define _USE_MATH_DEFINES
#endif
#endif
#include <math.h>
#include <float.h>
#include <limits.h>
#include <stdint.h>
#ifndef EOF
#define EOF (-1)
#endif

/* ---- overridable libc wrappers (core calls only these names) ---- */
#ifndef PUCHI_MALLOC
#define PUCHI_MALLOC malloc
#endif
#ifndef PUCHI_FREE
#define PUCHI_FREE free
#endif
#ifndef PUCHI_MEMCPY
#define PUCHI_MEMCPY memcpy
#endif
#ifndef PUCHI_MEMMOVE
#define PUCHI_MEMMOVE memmove
#endif
#ifndef PUCHI_MEMSET
#define PUCHI_MEMSET memset
#endif
#ifndef PUCHI_MEMCMP
#define PUCHI_MEMCMP memcmp
#endif
#ifndef PUCHI_STRLEN
#define PUCHI_STRLEN strlen
#endif
#ifndef PUCHI_STRCMP
#define PUCHI_STRCMP strcmp
#endif
#ifndef PUCHI_STRNCMP
#define PUCHI_STRNCMP strncmp
#endif
#ifndef PUCHI_STRNCPY
#define PUCHI_STRNCPY strncpy
#endif
#ifndef PUCHI_STRCHR
#define PUCHI_STRCHR strchr
#endif
#if defined(_WIN32)
#ifndef PUCHI_STRCASECMP
#define PUCHI_STRCASECMP _stricmp
#endif
#ifndef PUCHI_STRNCASECMP
#define PUCHI_STRNCASECMP _strnicmp
#endif
#else
#ifndef PUCHI_STRCASECMP
#define PUCHI_STRCASECMP strcasecmp
#endif
#ifndef PUCHI_STRNCASECMP
#define PUCHI_STRNCASECMP strncasecmp
#endif
#endif
#ifndef PUCHI_SNPRINTF
#define PUCHI_SNPRINTF snprintf
#endif
#ifndef PUCHI_SPRINTF
#define PUCHI_SPRINTF sprintf
#endif
#ifndef PUCHI_SSCANF
#define PUCHI_SSCANF sscanf
#endif
#ifndef PUCHI_ISALPHA
#define PUCHI_ISALPHA isalpha
#endif
#ifndef PUCHI_ISXDIGIT
#define PUCHI_ISXDIGIT isxdigit
#endif
#ifndef PUCHI_ISDIGIT
#define PUCHI_ISDIGIT isdigit
#endif
#ifndef PUCHI_ISSPACE
#define PUCHI_ISSPACE isspace
#endif
#ifndef PUCHI_TOLOWER
#define PUCHI_TOLOWER tolower
#endif
#ifndef PUCHI_TOUPPER
#define PUCHI_TOUPPER toupper
