/* puchi.h - amalgamated portable Chibi Scheme kernel
 *
 * Generated by puchi/tools/amalgamate.sh. Do not edit this file.
 * Change puchi/product/, patches/, and tools/ then re-run.
 *
 * Layout (stb-style):
 *   1) Banner — docs, includes, PUCHI_* libc/libm overrides, puchi_host types
 *   2) Host API — puchi_* / PUCHI_* types, macros, function decls (always visible)
 *   3) PUCHI_TEST — puchi_TEST_* harness symbols only (no Chibi sexp names)
 *   4) PUCHI_IMPLEMENTATION — sexp_* aliases + stripped Chibi decls
 *   5) PUCHI_IMPLEMENTATION && !PUCHI_TEST_CLIB — .c bodies + wrappers
 *
 * Lexical isolation: without PUCHI_IMPLEMENTATION, this header introduces only
 * puchi_* / PUCHI_* names (plus puchi_TEST_* when PUCHI_TEST is defined).
 * Chibi sexp_/SEXP_ names appear only under PUCHI_IMPLEMENTATION. Harness clibs
 * compile stubs with PUCHI_TEST + PUCHI_IMPLEMENTATION + PUCHI_TEST_CLIB
 * (decls only; see test/harness-include/chibi/eval.h). Never define PUCHI_TEST_CLIB
 * in production embeds. The impl TU defines IMPLEMENTATION and may also define
 * PUCHI_TEST so STATIC_LIBS paths compile.
 *
 * Hosts should use only documented puchi_* / PUCHI_* entrypoints and HOST-rated
 * macros (see product/puchi_host_symbols.txt). Do not depend on VM opcode enums,
 * core-form codes, heap/freelist layout details, or unmarked field accessors —
 * some INTERNAL helpers remain as ABI glue for HOST macros. Never define
 * PUCHI_TEST in production embeds.
 *
 * Chibi STATIC_LIBS is folded to defined(PUCHI_TEST), so some #if PUCHI_TEST
 * branches remain interleaved inside .c (include-shared).
 *
 * Host contract: core is CPU/memory only. The host owns OS I/O, clocks,
 * and process death. Pass puchi_host at context create (alloc/free required);
 * install ports with puchi_stream_ops (or string ports). Scheme calls C only
 * via host-registered foreigns (puchi_define_foreign).
 *
 * True single-header: no #include of opt/, chibi/, or lib/ project files.
 * OS/debug backends (dlopen, Boehm, green threads, mmap, image load, …) are
 * deleted from this amalgamation — not merely forced off. Do not re-enable.
 * The header has no OS ifdefs and no syscalls; a PUCHI_TEST harness may use
 * the CRT and may add OS names to *features* at runtime.
 *
 * Module path starts empty. puchi_load_default_libs loads embedded init-7 only
 * (idempotent; no disk). puchi_enable_modules(ctx, ops) ensures default libs,
 * installs host module I/O callbacks, and boots embedded meta-7 (import /
 * define-library). No include-shared / DLLs. STATIC_LIBS is harness-only
 * (define PUCHI_TEST in the test harness).
 *
 * ----------------------------------------------------------------------
 * How to use
 * ----------------------------------------------------------------------
 * In exactly one .c file:
 *
 *   #include <stdio.h>   // before puchi.h if using default PUCHI_SNPRINTF/...
 *   // Optional (stb §4): file-private API — single translation unit only.
 *   // Do NOT set PUCHI_STATIC in the multi-TU PUCHI_TEST harness / clibs.
 *   // #define PUCHI_STATIC
 *   #define PUCHI_IMPLEMENTATION
 *   #include "puchi.h"
 *
 *   static void *my_alloc(void *ud, size_t n) { (void)ud; return malloc(n); }
 *   static void my_free(void *ud, void *p) { (void)ud; free(p); }
 *   static void my_diag(void *ud, int code, const char *msg) { (void)ud; (void)code; (void)msg; }
 *   static void my_fatal(void *ud, int code, const char *msg); // must not return
 *
 *   puchi_host host = { NULL, my_alloc, my_free, my_diag, my_fatal };
 *   puchi ctx = puchi_create_context(0, 0, &host);  // host alloc/free required
 *   puchi_load_default_libs(ctx);                   // interaction language only
 *   // Or, for import / define-library (ops = exists/read/free_buf VFS):
 *   //   puchi_enable_modules(ctx, &ops);           // also loads default libs once
 *   puchi res = puchi_eval_string(ctx, "(+ 1 2)", -1, NULL);
 *   puchi_delete_context(ctx);
 *
 * Numeric modes: (none) / PUCHI_ENABLE_NUMERICAL_TOWER / PUCHI_INTEGER_ONLY
 * (set at most one of PUCHI_INTEGER_ONLY / PUCHI_ENABLE_NUMERICAL_TOWER).
 *
 * License: BSD-style (upstream COPYING / Alex Shinn).
 */
#ifndef PUCHI_H
#define PUCHI_H

#ifdef __cplusplus
extern "C" {
#endif

/* Includes needed by always-visible API macros / host typedefs. CRT extras
 * (stdlib, stdarg, float, limits) are under IMPLEMENTATION || TEST. */
#include <stddef.h>
#include <stdint.h>
#include <string.h>
#include <ctype.h>
#include <math.h>
/* Host: include <stdio.h> before this header when using default
 * PUCHI_SNPRINTF / SSCANF (sexp.h stdio is scrubbed). */
#ifndef EOF
#define EOF (-1)
#endif

/* ---- overridable libc / libm wrappers (core calls only these names) ---- */
#ifndef PUCHI_MEMCPY
#define PUCHI_MEMCPY memcpy
#endif
#ifndef PUCHI_MEMMOVE
#define PUCHI_MEMMOVE memmove
#endif
#ifndef PUCHI_MEMSET
#define PUCHI_MEMSET memset
#endif
#ifndef PUCHI_MEMCMP
#define PUCHI_MEMCMP memcmp
#endif
#ifndef PUCHI_STRLEN
#define PUCHI_STRLEN strlen
#endif
#ifndef PUCHI_STRCMP
#define PUCHI_STRCMP strcmp
#endif
#ifndef PUCHI_STRNCMP
#define PUCHI_STRNCMP strncmp
#endif
#ifndef PUCHI_STRNCPY
#define PUCHI_STRNCPY strncpy
#endif
#ifndef PUCHI_STRCHR
#define PUCHI_STRCHR strchr
#endif
#ifndef PUCHI_SNPRINTF
#define PUCHI_SNPRINTF snprintf
#endif
#ifndef PUCHI_SSCANF
#define PUCHI_SSCANF sscanf
#endif
#ifndef PUCHI_ISALPHA
#define PUCHI_ISALPHA isalpha
#endif
#ifndef PUCHI_ISDIGIT
#define PUCHI_ISDIGIT isdigit
#endif
#ifndef PUCHI_ISXDIGIT
#define PUCHI_ISXDIGIT isxdigit
#endif
#ifndef PUCHI_ISSPACE
#define PUCHI_ISSPACE isspace
#endif
#ifndef PUCHI_TOLOWER
#define PUCHI_TOLOWER tolower
#endif
#ifndef PUCHI_TOUPPER
#define PUCHI_TOUPPER toupper
#endif
/* Not ISO C. Portable static-inline bodies are emitted for
 * PUCHI_IMPLEMENTATION || PUCHI_TEST (harness clibs has TEST without IMPL). */
#ifndef PUCHI_STRCASECMP
#define PUCHI_STRCASECMP puchi_strcasecmp
#endif
#ifndef PUCHI_STRNCASECMP
#define PUCHI_STRNCASECMP puchi_strncasecmp
#endif

#ifndef PUCHI_LABS
#define PUCHI_LABS llabs
#endif
#ifndef PUCHI_POW
#define PUCHI_POW pow
#endif
#ifndef PUCHI_EXP
#define PUCHI_EXP exp
#endif
#ifndef PUCHI_LOG
#define PUCHI_LOG log
#endif
#ifndef PUCHI_SQRT
#define PUCHI_SQRT sqrt
#endif
#ifndef PUCHI_FLOOR
#define PUCHI_FLOOR floor
#endif
#ifndef PUCHI_CEIL
#define PUCHI_CEIL ceil
#endif
#ifndef PUCHI_FABS
#define PUCHI_FABS fabs
#endif
#ifndef PUCHI_FABSL
#define PUCHI_FABSL fabsl
#endif
#ifndef PUCHI_FMOD
#define PUCHI_FMOD fmod
#endif
#ifndef PUCHI_TRUNC
#define PUCHI_TRUNC trunc
#endif
#ifndef PUCHI_ISNAN
#define PUCHI_ISNAN isnan
#endif
#ifndef PUCHI_ISINF
#define PUCHI_ISINF isinf
#endif
#ifndef PUCHI_ISFINITE
#define PUCHI_ISFINITE isfinite
#endif
#ifndef PUCHI_ROUND
#define PUCHI_ROUND round
#endif
#if !defined(PUCHI_INTEGER_ONLY)
#ifndef PUCHI_SIN
#define PUCHI_SIN sin
#endif
#ifndef PUCHI_COS
#define PUCHI_COS cos
#endif
#ifndef PUCHI_TAN
#define PUCHI_TAN tan
#endif
#ifndef PUCHI_ATAN
#define PUCHI_ATAN atan
#endif
#if defined(PUCHI_ENABLE_NUMERICAL_TOWER)
#ifndef PUCHI_ATAN2
#define PUCHI_ATAN2 atan2
#endif
#ifndef PUCHI_SINH
#define PUCHI_SINH sinh
#endif
#ifndef PUCHI_COSH
#define PUCHI_COSH cosh
#endif
#ifndef PUCHI_ACOS
#define PUCHI_ACOS acos
#endif
#endif /* PUCHI_ENABLE_NUMERICAL_TOWER */
#endif /* !PUCHI_INTEGER_ONLY */

#ifndef PUCHI_NORETURN
#if defined(_MSC_VER)
#define PUCHI_NORETURN __declspec(noreturn)
#else
#define PUCHI_NORETURN _Noreturn
#endif
#endif

/* ---- host callbacks (context create) ---- */
enum {
  PUCHI_DIAG_WARN = 1,
  PUCHI_DIAG_EXCEPTION = 2,
  PUCHI_FATAL_STRICT = 100,
  PUCHI_FATAL_INTERNAL = 101
};

typedef struct puchi_host {
  void *userdata;
  void *(*alloc)(void *userdata, size_t size);
  void (*free)(void *userdata, void *ptr);
  void (*diagnose)(void *userdata, int code, const char *msg);
  void (*fatal)(void *userdata, int code, const char *msg); /* must not return */
} puchi_host;

typedef struct puchi_stream_ops {
  int (*read_char)(void *udata);
  int (*write_char)(void *udata, int c);
  int (*unget_char)(void *udata, int c);
  size_t (*read)(void *udata, void *buf, size_t n);
  size_t (*write)(void *udata, const void *buf, size_t n);
  int (*flush)(void *udata);
  void (*close)(void *udata);
  int (*eof_p)(void *udata);
  int (*error_p)(void *udata);
  void (*clear_error)(void *udata);
} puchi_stream_ops;

/* Host VFS for puchi_enable_modules — disk, zip, or embedded string table.
 * Stored on the context heap by puchi_enable_modules. */
typedef struct puchi_module_ops {
  void *userdata;
  int (*exists)(void *userdata, const char *name); /* 1 if readable */
  char *(*read)(void *userdata, const char *name, size_t *len); /* NULL if missing */
  void (*free_buf)(void *userdata, char *buf);
} puchi_module_ops;

/* ---- install.h identity (puchi_* always visible; sexp_* aliases under IMPL) ---- */
#define puchi_default_module_path ""
#define puchi_platform "puchi"
#define puchi_architecture "portable"
#define puchi_version "0.12.0"
#define puchi_release_name "puchi"
