/* Portable case-insensitive compare (no _stricmp / strcasecmp). */
static inline int puchi_strcasecmp(const char *a, const char *b) {
  unsigned char ca, cb;
  for (;;) {
    ca = (unsigned char)PUCHI_TOLOWER((unsigned char)*a++);
    cb = (unsigned char)PUCHI_TOLOWER((unsigned char)*b++);
    if (ca != cb) return (int)ca - (int)cb;
    if (ca == 0) return 0;
  }
}
static inline int puchi_strncasecmp(const char *a, const char *b, size_t n) {
  unsigned char ca, cb;
  if (n == 0) return 0;
  do {
    ca = (unsigned char)PUCHI_TOLOWER((unsigned char)*a++);
    cb = (unsigned char)PUCHI_TOLOWER((unsigned char)*b++);
    if (ca != cb) return (int)ca - (int)cb;
    if (ca == 0) return 0;
  } while (--n != 0);
  return 0;
}
#ifndef PUCHI_STRCASECMP
#define PUCHI_STRCASECMP puchi_strcasecmp
#endif
#ifndef PUCHI_STRNCASECMP
#define PUCHI_STRNCASECMP puchi_strncasecmp
#endif

static inline double puchi_f64_from_bits(uint64_t u) {
  double d;
  PUCHI_MEMCPY(&d, &u, sizeof(d));
  return d;
}

/* ---- host callbacks (context create) ---- */
enum {
  PUCHI_DIAG_WARN = 1,
  PUCHI_DIAG_EXCEPTION = 2,
  PUCHI_FATAL_STRICT = 100,
  PUCHI_FATAL_INTERNAL = 101
};

typedef struct puchi_host {
  void *userdata;
  void *(*alloc)(void *userdata, size_t size);
  void (*free)(void *userdata, void *ptr);
  void (*diagnose)(void *userdata, int code, const char *msg);
  void (*fatal)(void *userdata, int code, const char *msg); /* must not return */
} puchi_host;

typedef struct puchi_stream_ops {
  int (*read_char)(void *udata);
  int (*write_char)(void *udata, int c);
  int (*unget_char)(void *udata, int c);
  size_t (*read)(void *udata, void *buf, size_t n);
  size_t (*write)(void *udata, const void *buf, size_t n);
  int (*flush)(void *udata);
  void (*close)(void *udata);
  int (*eof_p)(void *udata);
  int (*error_p)(void *udata);
  void (*clear_error)(void *udata);
} puchi_stream_ops;

/* Host VFS for sexp_enable_modules — disk, zip, or embedded string table.
 * Stored on the context heap by sexp_enable_modules. */
typedef struct puchi_module_ops {
  void *userdata;
  int (*exists)(void *userdata, const char *name); /* 1 if readable */
  char *(*read)(void *userdata, const char *name, size_t *len); /* NULL if missing */
  void (*free_buf)(void *userdata, char *buf);
} puchi_module_ops;

#if defined(PUCHI_IMPLEMENTATION)
static void puchi_default_diagnose(void *ud, int code, const char *msg) {
  (void)ud;
  (void)code;
  (void)msg;
}
static void puchi_default_fatal(void *ud, int code, const char *msg) {
  (void)ud;
  (void)code;
  (void)msg;
  for (;;) {
  }
}

/* Defined after sexp.h (need sexp_context_heap). */
static void *puchi_host_alloc(void *ctx, size_t size);
static void puchi_host_free(void *ctx, void *ptr);
static void puchi_diagnose(void *ctx, int code, const char *msg);
static void puchi_fatal(void *ctx, int code, const char *msg);
#endif /* PUCHI_IMPLEMENTATION */

/* ---- allocator hooks (per-context host on the heap; no process global) ---- */
#ifndef SEXP_MALLOC
#if defined(PUCHI_IMPLEMENTATION)
#define SEXP_MALLOC(ctx, size) puchi_host_alloc((void *)(ctx), (size))
#else
#define SEXP_MALLOC(ctx, size) ((void)(ctx), (void)(size), (void *)0)
#endif
#endif
#ifndef SEXP_FREE
#if defined(PUCHI_IMPLEMENTATION)
#define SEXP_FREE(ctx, ptr) puchi_host_free((void *)(ctx), (ptr))
#else
#define SEXP_FREE(ctx, ptr) ((void)(ctx), (void)(ptr))
#endif
#endif

